    {
      "quest": "400000c2",
      "package": "QuestFindMillerLostWish",
      "field": "summary",
      "table": "25001699",
      "key": "6c459364",
      "text_raw": "\n\nThe Arwic Mines Overseer has a friend in Lost Wish who needs your help!\n\n",
      "records": [
        {
          "table": "25001699",
          "sha256": "75182b5e678e800ccc91f18ce721aae63afe452523528d78c5d90019f0538552",
          "installed_record_identical": true
