+#[test]
+fn retiring_an_environment_preserves_the_surviving_music_owner() {
+    let sink = RecordingSink::new();
+    let mut manager = SoundManager::new(Box::new(sink.clone()), Arc::new(Musics));
+    let mut ambient = AmbientSound::default();
+    ambient.set_data(Some(data()));
+    update(&mut ambient, &mut manager, 1.0, &[(FOREST, [1.0, 0.0, 0.0])]);
+    update(&mut ambient, &mut manager, 2.0, &[(TOWN, [1.0, 0.0, 0.0])]);
+    ambient.use_time(3.0, &mut manager); // Removes forest; town moves into slot zero.
+    let before = started(&sink).len();
+    update(&mut ambient, &mut manager, 4.0, &[(TOWN, [1.0, 0.0, 0.0])]);
+    assert_eq!(started(&sink).len(), before, "stable environment must not restart its music");
+    update(&mut ambient, &mut manager, 5.0, &[(FOREST, [1.0, 0.0, 0.0])]);
+    assert_eq!(ambient.environment(), Some(0x2900_0001));
+    assert_eq!(ambient.sound_types()[0], FOREST, "returning environment becomes dominant again");
+    assert!(started(&sink).len() > before, "returning forest music starts");
+}
