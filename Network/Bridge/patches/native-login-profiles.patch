+//! CNativeFactory::PackNativeObject (AppInfoHash, 0x0f):
+//! PHashTable<unsigned long,AppearanceInfo>::StreamPack, with each value
+//! packed by AppearanceInfo::StreamPack as a key/scalar hash. This native
+//! object also occurs inside the player's initial script inventory profile.
+use crate::protocol::reader::{Reader, Writer, MAX_ITEMS};
+use crate::protocol::types::float_table;
+use crate::protocol::ProtocolError;
+use crate::protocol::VisualDesc;
+
+/// CNativeFactory's VisualDesc (0x71) uses the same bounded StreamPack decoder
+/// as world object creates. Preserve its original hash headers and FX payload
+/// when a script reference is re-packed; neither view nor bytes can be mutated.
+#[derive(Debug, Clone, PartialEq)]
+pub struct NativeVisualDesc { visual: VisualDesc, packed: Vec<u8> }
+impl NativeVisualDesc {
+    pub fn visual(&self) -> &VisualDesc { &self.visual }
+    pub(crate) fn read(r:&mut Reader<'_>)->Result<Self,ProtocolError> {
+        let (visual,packed)=r.capture(VisualDesc::read)?;
+        Ok(Self{visual,packed})
+    }
+    pub(crate) fn write(&self,w:&mut Writer) {w.bytes.extend_from_slice(&self.packed);}
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub struct AppInfoHash {
+    pub bucket_index: u8,
+    /// Appearance table DID, nested bucket index, appearance key/scalar pairs.
+    pub tables: Vec<(u32, u8, Vec<(u32, f32)>)>,
+}
+impl AppInfoHash {
+    pub(crate) fn read(r: &mut Reader<'_>) -> Result<Self, ProtocolError> {
+        let header=r.u32()?;
+        let count=(header & 0x00ff_ffff) as usize;
+        if count>MAX_ITEMS || count.saturating_mul(8)>r.remaining() {
+            return Err(ProtocolError::Invalid("appearance hash count"));
+        }
+        let mut tables=Vec::with_capacity(count);
+        for _ in 0..count {
+            let did=r.u32()?;
+            let (buckets,keys)=float_table(r)?;
+            tables.push((did,buckets,keys));
+        }
+        Ok(Self{bucket_index:(header>>24) as u8,tables})
+    }
+    pub(crate) fn write(&self,w:&mut Writer) {
+        w.u32((u32::from(self.bucket_index)<<24)|self.tables.len() as u32);
+        for (did,buckets,keys) in &self.tables {
+            w.u32(*did).u32((u32::from(*buckets)<<24)|keys.len() as u32);
+            for (key,scalar) in keys {w.u32(*key).f32(*scalar);}
+        }
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::protocol::{NativeObject,PackValue,pack_values,unpack_values};
+    #[test]
+    fn nested_appearance_hash_keeps_following_profile_arguments_aligned() {
+        for tables in [vec![],vec![(0x19000001,2,vec![(3,0.25),(4,0.75)])]] {
+            let values=vec![PackValue::Int(7),PackValue::native(NativeObject::AppInfoHash(AppInfoHash{bucket_index:3,tables})),PackValue::LongInt(0x8140000000000001)];
+            let bytes=pack_values(&values);
+            assert_eq!(unpack_values(&bytes).unwrap(),values);
+            assert!(unpack_values(&bytes[..bytes.len()-1]).is_err());
+        }
+        assert!(AppInfoHash::read(&mut Reader::new(&4097u32.to_le_bytes())).is_err());
+    }
+    #[test]
+    fn native_visual_desc_is_bounded_and_repacked_without_losing_headers() {
+        let mut bytes=vec![];
+        for word in [0x102u32,0x1f000001,0x20,0x02000001,0x19000001,0x03000001,7,0.5f32.to_bits()] {bytes.extend(word.to_le_bytes());}
+        let visual=NativeVisualDesc::read(&mut Reader::new(&bytes)).unwrap();
+        assert_eq!(visual.visual().parent,Some(0x1f000001));
+        assert_eq!(visual.visual().global_mods.as_ref().unwrap().appearance[0].1,vec![(7,0.5)]);
+        assert!(NativeVisualDesc::read(&mut Reader::new(&bytes[..bytes.len()-1])).is_err());
+        let values=vec![PackValue::native(NativeObject::VisualDesc(Box::new(visual))),PackValue::Int(29)];
+        let packed=pack_values(&values);
+        assert_eq!(unpack_values(&packed).unwrap(),values);
+        assert_eq!(pack_values(&unpack_values(&packed).unwrap()),packed);
+    }
+}
